<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
	            %cyan([%date{"yyyy-MM-dd"}) %green(%date{"HH:mm:ss.SSS",UTC}])-%highlight([%-5p])-%blue([%-45.45(%C{0}.%M:%L)]) -- %msg%n
            </pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
